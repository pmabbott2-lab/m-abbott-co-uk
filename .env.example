# Copy to .env and fill in your values

# --- Supabase (client + server) ---
# From Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_PROJECT_ID=your_project_id

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_id

# Server-only: required for admin operations (password reset generateLink in dev, session deletes)
# Dashboard → Settings → API → service_role (never commit or expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — for `npm run bootstrap:supabase` automation:
# SUPABASE_ACCESS_TOKEN=   # https://supabase.com/dashboard/account/tokens
# SUPABASE_DB_PASSWORD=    # Project Settings → Database → database password

# Canonical app URL for auth email links (password reset, email confirmation, OAuth).
# Must match Supabase Dashboard → Authentication → URL Configuration:
#   Site URL: http://localhost:8080  (or your production URL)
#   Redirect URLs: http://localhost:8080/**  (and your production URL/**)
VITE_APP_URL=http://localhost:8080

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Realtime avatar (Simli) — OPTIONAL, OFF by default ---
# Powers the real-time, lip-synced "Susan" avatar. When VITE_REALTIME_AVATAR is
# not "true", none of this is used and the app shows the static portrait exactly
# as before. We keep our OpenAI `sage` TTS + STT; Simli only renders the face and
# lip-syncs to our audio. Pricing ~ $0.01/min (one session per interview).
#
# Server-only (never exposed to the browser): https://app.simli.com → API key
SIMLI_API_KEY=
# The Trinity faceId generated from src/assets/susan.png (see scripts/create-simli-face.sh)
SIMLI_FACE_ID=
# Client flag — set to exactly "true" to enable the realtime avatar.
VITE_REALTIME_AVATAR=false
