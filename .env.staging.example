# Mortgage Hub — STAGING environment template (PLACEHOLDERS ONLY)
# Copy to a private staging secrets store / Azure App Settings.
# NEVER commit real credentials. NEVER copy production secret VALUES.

# =============================================================================
# REQUIRED — environment identity (must be unique to staging)
# =============================================================================
APP_ENV=staging
VITE_APP_ENV=staging
COMMUNICATION_DELIVERY_MODE=capture

# Staging public origin (NOT https://mymortgagehub.uk).
# First deploy uses the Azure default hostname. Do not use
# https://staging.mymortgagehub.uk until DNS is authorised.
APP_BASE_URL=https://mortgagehub-staging-f4duc9h6ghhgfwhk.uksouth-01.azurewebsites.net
VITE_APP_URL=https://mortgagehub-staging-f4duc9h6ghhgfwhk.uksouth-01.azurewebsites.net

# =============================================================================
# REQUIRED — separate Supabase staging project (must not be production)
# =============================================================================
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_STAGING_ONLY
SUPABASE_SERVICE_ROLE_KEY=sb_secret_STAGING_ONLY
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_STAGING_ONLY
VITE_SUPABASE_PROJECT_ID=YOUR_STAGING_PROJECT_REF

# =============================================================================
# MUST NOT COPY FROM PRODUCTION
# =============================================================================
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_MESSAGING_SERVICE_SID
# TEAMS_CLIENT_SECRET / TEAMS_TOKEN_SECRET
# SUPABASE_SERVICE_ROLE_KEY (production)
# Any production webhook signing secrets
# Graph refresh tokens belonging to production advisers

# =============================================================================
# TWILIO — default BLOCKED (do not set production SIDs)
# Optional dedicated Twilio test/subaccount later:
#   STAGING_TWILIO_ALLOW_LIVE=true
#   + staging-only TWILIO_* credentials
# Leave unset for capture/disabled (recommended for first UAT).
# =============================================================================
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_VOICE_PHONE_NUMBER=
# TWILIO_PHONE_NUMBER=
# STAGING_TWILIO_ALLOW_LIVE=false

# =============================================================================
# MICROSOFT GRAPH / TEAMS — default BLOCKED
# Optional later: dedicated test Entra app + STAGING_TEAMS_ALLOW_LIVE=true
# Redirect: {APP_BASE_URL}/api/teams/callback
# =============================================================================
# TEAMS_CLIENT_ID=
# TEAMS_CLIENT_SECRET=
# TEAMS_TENANT_ID=
# TEAMS_TOKEN_SECRET=
# STAGING_TEAMS_ALLOW_LIVE=false
# STAGING_TEAMS_ALLOW_READ=false

# =============================================================================
# SUSAN / AVATAR / TTS / STT — default OFF in staging
# Set STAGING_SUSAN_ENABLED=true only with staging/test API keys.
# =============================================================================
STAGING_SUSAN_ENABLED=false
STAGING_OPENAI_ENABLED=false
STAGING_GETADDRESS_ENABLED=false
# SIMLI_API_KEY=
# SIMLI_FACE_ID=
# OPENAI_API_KEY=
# VITE_REALTIME_AVATAR=false

# =============================================================================
# AUTH / MFA
# =============================================================================
VITE_SKIP_LOGIN_MFA=true
# Register staging redirect URLs in Supabase Auth:
#   {APP_BASE_URL}/auth
#   {APP_BASE_URL}/auth/reset
#   {APP_BASE_URL}/register

# =============================================================================
# OPTIONAL public non-secrets
# =============================================================================
# ADMIN_EMAILS=staging-owner@example.com
# VITE_MOCKUP_SITE_URL=

# =============================================================================
# Classification legend
#   required          — must be set for staging app to boot/UAT
#   must-be-unique    — must differ from production values
#   optional          — enable only when that service is deliberately tested
#   must-never-share  — never reuse production secret VALUES
# =============================================================================
